{
  "realm": "sentinelle",
  "enabled": true,
  "displayName": "Sentinelle - Compte agent",
  "sslRequired": "none",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "passwordPolicy": "length(12) and notUsername",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "en"],
  "defaultLocale": "fr",
  "roles": {
    "realm": [
      { "name": "agent", "description": "Agent public enrole : acces a la messagerie" },
      { "name": "admin-si", "description": "Administrateur securite : acces au portail d'administration" }
    ]
  },
  "requiredActions": [
    { "alias": "CONFIGURE_TOTP", "name": "Configurer le second facteur", "providerId": "CONFIGURE_TOTP", "enabled": true, "defaultAction": true, "priority": 10 },
    { "alias": "UPDATE_PASSWORD", "name": "Changer le mot de passe", "providerId": "UPDATE_PASSWORD", "enabled": true, "defaultAction": false, "priority": 30 },
    { "alias": "UPDATE_PROFILE", "name": "Mettre a jour le profil", "providerId": "UPDATE_PROFILE", "enabled": true, "defaultAction": false, "priority": 40 },
    { "alias": "VERIFY_PROFILE", "name": "Verifier le profil", "providerId": "VERIFY_PROFILE", "enabled": true, "defaultAction": false, "priority": 90 }
  ],
  "clients": [
    {
      "clientId": "synapse",
      "name": "Sentinelle - serveur de messagerie",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "demo-synapse-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://matrix.localhost:8080/_synapse/client/oidc/callback"],
      "webOrigins": [],
      "attributes": {
        "backchannel.logout.url": "http://synapse:8008/_synapse/client/oidc/backchannel_logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "portal",
      "name": "Sentinelle - portail d'administration",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "demo-portal-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://admin.localhost:8080/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "post.logout.redirect.uris": "http://admin.localhost:8080/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "portal-admin",
      "name": "Sentinelle - compte de service du portail",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "demo-portal-admin-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-portal-admin",
      "enabled": true,
      "serviceAccountClientId": "portal-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users", "view-realm"]
      }
    }
  ]
}
